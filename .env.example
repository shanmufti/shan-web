# Copy to .env.local and fill in real values. .env.local is gitignored — never commit real secrets.

# Payload CMS — any long random string, generate once and keep stable
PAYLOAD_SECRET=

# Neon Postgres — from your Neon project dashboard (Connect panel)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cloudflare R2 — R2 > Manage API tokens (bucket-scoped, Object Read & Write),
# and bucket Settings > Public Access for R2_PUBLIC_URL
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

# CARTO Basemaps — carto.com/basemaps/apikey. Public (sent to the browser):
# restrict it to your domains in the CARTO dashboard
NEXT_PUBLIC_CARTO_KEY=
